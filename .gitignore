__pycache__/
*.pyc
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/

# Output artefacts from the research / live-scan CLI tools.
# ac_probe.py writes {timestamp}_probe.json, ac_monitor.py writes
# {timestamp}_out.json; both default to cwd, so users running from
# the repo root will leak these files. Belt-and-braces ignore so a
# stray run never gets committed.
*_probe.json
*_out.json

# Local code-knowledge-graph output (graphify). Regenerable from source at no
# cost, and large — never committed.
graphify-out/
.graphify_python

# Opt-in switch for rebuilding the local code graph. Per working copy, never
# committed: its absence is what keeps a rebuild from firing on a deploy target,
# a CI runner or a throwaway clone.
.graphify-enabled
